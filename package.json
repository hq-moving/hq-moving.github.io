{
  "name": "headquarters-moving",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "generate-webp": "node scripts/generate-webp.cjs",
    "prebuild": "npm run generate-webp",
    "build": "next build",
    "postbuild": "node scripts/postbuild-s3.cjs",
    "start": "next start",
    "upload-s3": "aws s3 sync out/ s3://www.headquartersmoving.com && node scripts/upload-s3-routes.cjs",
    "invalidate-cf-cache": "aws cloudfront create-invalidation --distribution-id ECK5RK9DN3BCT --paths /*",
    "deploy-s3": "npm run build && npm run upload-s3 && npm run invalidate-cf-cache"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "aos": "^3.0.0-beta.6",
    "next": "^14.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
