# EmailJS — rename from REACT_APP_* to NEXT_PUBLIC_*
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_USER_ID=

# Site URL used for canonical links, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.headquartersmoving.com

# Static export for S3 (default). Set to false when moving to Amplify/Vercel/Node hosting.
# NEXT_STATIC_EXPORT=false

# Optional override for deploy scripts
# S3_BUCKET=s3://www.headquartersmoving.com
